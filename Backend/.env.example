# Copy to .env for local development. Never commit the real .env file.
SOLANA_VAULT_DATA_DIR=./data
SOLANA_VAULT_PATH=./data/vault.svault
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=1800
WALLET_SYNC_INTERVAL=60
ACTIVITY_SYNC_INTERVAL=45
PRICE_SYNC_INTERVAL=30
RISK_SYNC_INTERVAL=60
ALERT_SYNC_INTERVAL=20
STRATEGY_SYNC_INTERVAL=30
METADATA_SYNC_INTERVAL=300
BACKUP_RETENTION_COUNT=25
REDIS_URL=
# Keep false. This project is simulation-first; live transaction broadcasting
# requires a separate security review and explicit operator-controlled change.
ENABLE_LIVE_EXECUTION=false
# Provider credentials belong in the encrypted in-app vault, not this file.
# Automatic read-only balance and activity reconciliation while the vault is unlocked.
PORTFOLIO_RECONCILIATION_INTERVAL=120